# Copy to .env and fill in at least one key. Never commit .env.
# Forge tries providers in the order listed in FORGE_PROVIDERS and fails over on errors.

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Comma-separated failover order. Providers without a key are skipped.
# Free tiers meter quota per model, so several Gemini models are listed (each about 20 requests/day).
FORGE_PROVIDERS=gemini:gemini-3.5-flash,gemini:gemini-3-flash-preview,gemini:gemini-3.6-flash,groq,gemini:gemini-3.1-flash-lite,openrouter

# Optional model overrides
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Default LLM mode for new runs: "mock" (offline, scripted) or "live"
FORGE_DEFAULT_MODE=mock
